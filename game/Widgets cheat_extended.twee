:: Widgets cheat_extended [widget]

<<widget "black_stores_setting">>

<div class="dol-settings dol-shadow">

    <!-- 標題 -->
    <div class="dol-header">
        <span class="dol-title gold">黑心商店</span>
    </div>

    <!-- 主體 -->
    <div class="dol-body">
        <div class="dol-desc">
            一次賣出更多的商品，敲詐更多錢。
        </div>
        <br>
        
        <!-- 初始化變數 -->
        <<if $black_storeswich is undefined>>
            <<set $black_storeswich = 0>>
            <<set $black_store_FIX_MIN = 11>>
            <<set $black_store_FIX_MAX = 30>>
            <<set $stall_cost_FIX = 1>>
        <</if>>
        <!-- 開關按鈕 -->
        <div class="dol-btn">
            <<button "黑心商店">>
                <<set $black_storeswich = $black_storeswich == 0 ? 1 : 0>>
                <<replace #CE_settingsDiv>>
                    <<black_stores_setting>><br><br>
                <</replace>>
            <</button>>
        </div>
        <br>

        <!-- 模式重設變數 -->
        <<if $black_storeswich is 0>>
            <<set $black_store_FIX_MIN = 11>>
            <<set $black_store_FIX_MAX = 30>>
            <<set $stall_cost_FIX = 1>>
        <</if>>

        <!-- 開關狀態顯示 -->
        <div class="dol-desc">
            黑心商店模式：
            <<if $black_storeswich is 0>>
                <span class="red">關</span>
            <<else>>
                <span class="green">開</span>
            <</if>>
        </div>
        <br>

        <!-- 隨機數下限 -->
        <div class="dol-btn">
            <div class="dol-desc">設定黑心商店隨機數下限：</div>
            <<numberslider "$black_store_FIX_MIN" $black_store_FIX_MIN 11 1100 11>>
            <<link "確定">>
                <<if $black_storeswich is 0>>
                    <<set $black_store_FIX_MIN = 11>>
                    <<set $black_store_FIX_MAX = 30>>
                    <<set $stall_cost_FIX = 1>>
                <</if>>
                <<replace #CE_settingsDiv>>
                    <<black_stores_setting>><br><br>
                <</replace>>
            <</link>>
        </div>
        <br>

        <!-- 隨機數上限 -->
        <div class="dol-btn">
            <div class="dol-desc">設定黑心商店隨機數上限：</div>
            <<numberslider "$black_store_FIX_MAX" $black_store_FIX_MAX 30 3000 10>>
            <<link "確定">>
                <<if $black_storeswich is 0>>
                    <<set $black_store_FIX_MIN = 11>>
                    <<set $black_store_FIX_MAX = 30>>
                    <<set $stall_cost_FIX = 1>>
                <</if>>
                <<replace #CE_settingsDiv>>
                    <<black_stores_setting>><br><br>
                <</replace>>
            <</link>>
        </div>

        <br>

        <!-- 當前隨機數顯示 -->
        <div class="dol-desc">
            當前銷售隨機數下限：$black_store_FIX_MIN 個<br>
            當前銷售隨機數上限：$black_store_FIX_MAX 個
        </div>
        <br>

        <!-- 銷售額倍數 -->
        <div class="dol-btn">
            <div class="dol-desc">設定黑心商店銷售額倍數：</div>
            <<numberslider "$stall_cost_FIX" $stall_cost_FIX 1 200 1>>
            <<link "確定">>
                <<if $black_storeswich is 0>>
                    <<set $black_store_FIX_MIN = 11>>
                    <<set $black_store_FIX_MAX = 30>>
                    <<set $stall_cost_FIX = 1>>
                <</if>>
                <<replace #CE_settingsDiv>>
                    <<black_stores_setting>><br><br>
                <</replace>>
            <</link>>
        </div>
        <br>
        <div class="dol-desc">
            當前銷售額倍數：$stall_cost_FIX 倍。
        </div>
    </div> <!-- end dol-body -->
</div> <!-- end dol-settings -->

<</widget>>

<<widget "dance_reward_setting">>

<div class="dol-settings dol-shadow">

    <!-- 標題 -->
    <div class="dol-header">
        <span class="dol-title gold">跳舞報酬加倍</span>
    </div>

    <!-- 主體 -->
    <div class="dol-body">

        <div class="dol-desc">
            跳舞報酬加倍，輕鬆賺錢。
        </div>
        <br>

        <!-- 初始化 -->
        <<if $dance_reward_swich is undefined>>
            <<set $dance_reward_swich = 0>>
        <</if>>

        <!-- 開關按鈕 -->
        <div class="dol-btn">
            <<button "跳舞報酬加倍">>
                <<set $dance_reward_swich = $dance_reward_swich == 0 ? 1 : 0>>
                <<replace #CE_settingsDiv>>
                    <<dance_reward_setting>><br><br>
                <</replace>>
            <</button>>
        </div>
        <br>

        <!-- 當前狀態 -->
        <div class="dol-desc">
            跳舞報酬加倍開關：
            <<if $dance_reward_swich is 0>>
                <span class="red">關</span>
                <<set $dancetip_FIX = 1>>
            <<else>>
                <span class="green">開</span>
            <</if>>
        </div>
        <br>

        <!-- 倍率調整 -->
        <div class="dol-section">
            <div class="dol-desc">設定跳舞報酬加倍倍數：</div>

            <<if $dancetip_FIX is undefined>>
                <<set $dancetip_FIX = 1>>
            <</if>>           
            <<numberslider "$dancetip_FIX" $dancetip_FIX 1 200 1>>
        
            
            <div class="dol-link">
                <<link "確定">>
                    <<if $dance_reward_swich isnot 1>>
                        <<set $dancetip_FIX = 1>>
                    <</if>>
                    <<replace #CE_settingsDiv>>
                        <<dance_reward_setting>><br><br>
                    <</replace>>
                <</link>>
            </div>
        </div>
        <br>

        <div class="dol-desc">
            當前跳舞報酬倍數：$dancetip_FIX 倍。
        </div>
    </div> <!-- end dol-body -->
</div> <!-- end dol-settings -->

<</widget>>

<<widget "swich_DEBUG_MODE">>

<div class="dol-settings dol-shadow">

    <!-- 標題 -->
    <div class="dol-header">
        <span class="dol-title gold">DEBUG MODE</span>
    </div>

    <!-- 主體描述 -->
    <div class="dol-body">
        DEBUG MODE ，限除錯用，請謹慎使用。            
   
    <div style="display:flex; gap:0.5em; flex-wrap:wrap; margin-top:0.5em;">
        <<button "上帝模式開關">>
            <<set $debug = $debug == 0 ? 1 : 0>>
            <<replace #debug_mode>>
                DEBUG MODE開關：
                <<if $debug is 0>>
                    <span style="color:red;">關</span>
                <<elseif $debug is 1>>
                    <span style="color:green;">開</span>   
                <</if>>
            <</replace>>
            <<if $("#CE_settingsDiv").length>>
	            <<replace #CE_settingsDiv>><<swich_DEBUG_MODE>><br><br><</replace>>
            <</if>>
        <</button>>

        <<button "卸載 cheatExtended">>
            <<script>>
                if (confirm("確認要卸載 cheatExtended 並清除相關變數嗎？")) {
                    window.clearCEVars();
                    alert("已清除 CE 相關變數！");
                }
            <</script>>
        <</button>>
    </div>

    <br>

    <<if $debug is 1>>
    <div style="border:1px solid #aaa; padding:0.5em 0.8em; border-radius:6px; margin-top:1em;">
        <div style="color:red; font-weight:bold; margin-bottom:0.3em;">作弊拓展爆紅修復</div>
        <div style="margin-bottom:0.5em;">
            修復由舊版作弊拓展(1.3.2含更早版本)直接升級引發的功能爆紅問題。
            如果使用後仍無法修復，請至 github 提出 issues。
        </div>
        <<link [[修復作弊拓展功能爆紅|$passage]]>> 
            <<set $milk_releasedFIX_MIN to 0>>
            <<set $milk_releasedFIX_MAX to 0>>
            <<set $milk_volume to 0>>
            <<set $milk_max to 3000>>
            <<set $milk_amount to 0>>
            <<set $cccheat to []>>
            <<set $cccheat_name to []>>		
            <<set $cccheat_display to "">>
            <<set $cccheat_name_display to "">>
            <<set $bigest_wardrobe_fix to 20>>
        <</link>>
        <div style="margin-top:0.5em;">當前頁面(passage)：<span style="color:blue;">$passage</span></div>
    </div>
    <</if>>

    <br>

    <div id="debug_mode">
        DEBUG MODE 開關：
        <<if $debug is 0>>
            <span style="color:red;">關</span>
        <<elseif $debug is 1>>
            <span style="color:green;">開</span>   
        <</if>>
    </div>

    </div>
</div>

<</widget>>

<<widget "bigest_wardrobe_mod">>

<div class="dol-settings dol-shadow">

    <!-- 標題 -->
    <div class="dol-header">
        <span class="dol-title gold">大容量衣櫃</span>
    </div>

    <!-- 主體 -->
    <div class="dol-body">
        <div class="dol-desc">異次元空間衣櫃，再也不擔心老師們的衣服太好看但衣櫃放不下了！</div>
        <div class="dol-desc"></div>
        <br>

        <<set _wardrobe to Furniture.get('wardrobe')>>
        <<if _wardrobe.type.includes('starter')>>
            <<set _default_wardrobe to 20>>
        <<elseif _wardrobe.type.includes('spacious')>>
            <<set _default_wardrobe to 30>>
        <<elseif _wardrobe.type.includes('organiser')>>
            <<set _default_wardrobe to 40>>
        <<else>>
            <<set _default_wardrobe to 20>>
        <</if>>

        <<if $bigest_wardrobe_swich is undefined or $bigest_wardrobe_fix is undefined>>
            <<set $bigest_wardrobe_swich to 0>>
            <<set $bigest_wardrobe_fix to _default_wardrobe>>
        <</if>>

        <!-- 按鈕 -->
        <div class="dol-btn">
            <<button "異次元空間衣櫃">>
                <<set $bigest_wardrobe_swich = $bigest_wardrobe_swich == 0 ? 1 : 0>>
                <<replace #CE_settingsDiv>><<bigest_wardrobe_mod>><br><br><</replace>>
            <</button>>
        </div>
        <br>

        <div class="dol-desc">
            異次元空間衣櫃開關：
            <<if $bigest_wardrobe_swich is 0>>
                <span class="red">關</span>
            <<elseif $bigest_wardrobe_swich is 1>>
                <span class="green">開</span>
            <</if>>
        </div>
        <br>

        <div class="dol-section">
            在此設定異次元空間衣櫃容量，當前設定容量為 $wardrobe.space
       
            <<numberslider "$bigest_wardrobe_fix" $bigest_wardrobe_fix 20 10000 10>>
            <span class="dol-link">
                <<link "確定">>
                    <<if $bigest_wardrobe_swich is 1>>
                        <<set $wardrobe.space to $bigest_wardrobe_fix>>
                    <</if>>
                    <<replace #CE_settingsDiv>><<bigest_wardrobe_mod>><br><br><</replace>>
                <</link>>
            </span>
        </div>
        <br>

        <div class="dol-desc">
            當前預設容量：_default_wardrobe
        </div>
        <span class="dol-link">
            <<link "恢復預設">>
                <<set $wardrobe.space to _default_wardrobe>>
                <<set $bigest_wardrobe_fix to _default_wardrobe>>
                <<replace #CE_settingsDiv>><<bigest_wardrobe_mod>><br><br><</replace>>
            <</link>>
        </span>
        <hr>
        ⚠️<span class = "red">可啟用<<link "狀態變數hook">><<replace #CE_settingsDiv>><<quick_yanling>><</replace>><</link>>防止第三方修改衣櫃容量。</span>
    </div>

</div>

<</widget>>


<<widget "quick_yanling">>
    <div class="dol-settings dol-shadow">

        <!-- 標題 -->
        <div class="dol-header">
            <span class="dol-title gold">快速言靈/其他</span>
        </div>

        <!-- 主體 -->
        <div class="dol-body">
            <div class="dol-title gold">其他功能：</div>

            <!-- 特質鎖定 -->
            <div class="settingsToggleItem">
                <div class="small-description">
                    蜜癮者/植物愛好者特質鎖定
                </div>
                <label>
                    <<checkbox "$CE_nectarKeeperEnabled" false true autocheck>>
                    蜜癮者/植物愛好者特質鎖定
                </label>
                <mouse class="tooltip linkBlue">(?)
                    <span>
                        需先獲得植物愛好者特質，否則功能無效，可從原版作弊選單快速獲得
                    </span>
                </mouse>
            </div>
            <hr>

            <!-- 每日額外恢復 -->
            <div class="settingsToggleItem">
                <div class="small-description">
                    每日自動恢復額外狀態（疼痛、疲勞、壓力、自控等）
                </div>
                <label>
                    <<checkbox "$swich_extraStatusRestore" false true autocheck>>
                    啟用每日額外恢復
                </label>
                <mouse class="tooltip linkBlue">(?)
                    <span>
                        開啟後，每天遊戲時間將額外恢復各項狀態數值。<br>
                        💡 注意：此恢復僅限額外狀態，不影響遊戲原本時間流逝造成的變化。
                    </span>
                </mouse>
            </div>
            <hr>

            <!-- 狀態變數 Hook -->
            <div class="settingsToggleItem">
                <div class="small-description">
                    啟用後，系統會統一管理以下狀態變數的變化：疼痛、興奮、疲勞、壓力、創傷以及自控。
                    可以透過 <<link "狀態控制">><<replace #CE_settingsDiv>><<CE_statControlPanel>><</replace>><</link>>來設定相關參數。
                </div>
                <label>
                    <<checkbox "$CE_VarHook_enable" false true autocheck>>
                    ⚠️狀態變數hook
                </label>
                <mouse class="tooltip linkBlue">(?)
                    <span>
                        實驗性功能，可能存在非預期的作用。<br>
                    </span>
                </mouse>
                <br>
                <hr>

                <!-- 天使無限放逐 -->
                <div class="small-description">
                    天使化Pc放逐觸手次數不再減少，<br>
                    需啟用狀態變數hook。
                </div>
                <label>
                    <<checkbox "$CE_noAngelBanishLoss" false true autocheck>>
                    天使無限放逐
                </label>
                <mouse class="tooltip linkBlue">(?)
                    <span>
                        實驗性功能，可能存在非預期的作用。
                    </span>
                </mouse>
                <br>
                <hr>

                <!-- 永不耗氧 -->
                <div class="small-description">
                    戰鬥場景&水下場景氧氣值將鎖定在最大值。<br>
                    需啟用狀態變數hook。
                </div>
                <label>
                    <<checkbox "$CE_lockOxygenEnabled" false true autocheck>>
                    永不耗氧
                </label>
                <mouse class="tooltip linkBlue">(?)
                    <span>
                        戰鬥（敵人嘗試掐Pc脖子）及潛水場景不再消耗氧氣
                    </span>
                </mouse>
                <br>
            </div>
            <hr>

            <div class="dol-title gold">一鍵執行各種言靈：</div>
            <br>

            <!-- 衣物與身體 -->
            <details>
                <summary>衣物 / 身體</summary>
                <br>
                <span class="dol-link">
                    [[一鍵烘乾衣服|$passage][$upperwet to 0, $lowerwet to 0, $underlowerwet to 0, $underupperwet to 0]]
                </span>
                <br>
                <span class="dol-link">
                    [[pc縫衣服中…|$passage][$worn.upper.integrity += 1000,$worn.lower.integrity += 1000,$worn.under_lower.integrity += 1000,$worn.under_upper.integrity += 1000]]
                </span>
                <br>
            </details>

            <!-- 狀態 / 性 -->
            <details>
                <summary>狀態 / 性</summary>
                <br>
                <span class="dol-link">
                    [[狀態全恢復|$passage][$pain = 0,$arousal = 0,$tiredness = 0,$stress = 0,$trauma = 0,$control = 1000,$drunk = 0,$drugged = 0,$hallucinogen = 0]]
                </span>
                <br>
                <span class="dol-link">
                    [[PC立馬高潮|$passage][$semen_amount = $semen_volume,$semen_volume += 1000,$arousal = 10000]]
                </span>
                <br>
            </details>

            <!-- 防狼噴霧 / 道具 -->
            <details>
                <summary>防狼噴霧 / 道具</summary>
                <br>
                <span class="dol-link">
                    [[防狼噴霧+1|$passage][$spray +=1]]
                </span>
                <br>
                <span class="dol-link">
                    [[防狼噴霧上限+1|$passage][$spraymax +=1]]
                </span>
                <br>
                <span class="dol-link">
                    [[防狼噴霧上限-1|$passage][$spraymax +=-1]]
                </span>
                <br>
                <span class="dol-link">
                    [[防狼噴霧補滿|$passage][$spray = $spraymax]]
                </span>
                <br>
                <span class="dol-link">
                    [[金貞操帶|Lake Ruin Box][$rng = 96]]
                </span>
                <br>
            </details>

            <!-- 變化 / 轉化特性 -->
            <details>
                <summary>變化 / 轉化特性</summary>
                <br>
                <span class="dol-link">
                    [[pc長翅膀|$passage][$harpy to 100,$birdFly to 1]]
                </span>
                <br>
                <span class="dol-link">
                    [[去踏🐴的神殿 一鍵恢復貞潔誓言特質|$passage][$player.virginity.temple to true]]
                </span>
                <br>
                <span class="dol-link">
                    [[去除催眠暗示|$passage][$hypnosis to undefined]]
                </span>
                <br>
                <span class="dol-link">
                    [[去除渴望特質|$passage][$hypnosis_traits.scream to undefined]]
                </span>
                <br>
                <span class="dol-link">
                    [[去除炫耀特質|$passage][$hypnosis_traits.cover to undefined]]
                </span>
                <br>
                <span class="dol-link">
                    [[去除異種癖特質|$passage][$hypnosis_traits.deviancy to undefined]]
                </span>
                <br>
                <span class="dol-link">
                    [[一鍵恢復全童真|$passage][$player.virginity.vaginal to true,$player.virginity.penile to true,$player.virginity.anal to true,$player.virginity.oral to true,$player.virginity.handholding to true,$player.virginity.kiss to true]]
                </span>
                <br>
                <span class="dol-link">
                    [[增加🥛量+50000|$passage][$milk_volume to 50000]]
                </span>
                <br>
                <span class="dol-link">
                    [[🥛量上限+50000|$passage][$milk_max to 50000]]
                </span>
                <br>
                <span class="dol-link">
                    [[天使放逐次數上限(50)|$passage][$angelBanishMax to 50, $angelBanish to 50]]
                </span>
                <br>
                <span class="dol-link">
                    [[吃媚藥|$passage][$drugged += 1000]]
                </span>
                <br>
            </details>

            <!-- 動物化特性 -->
            <details>
                <summary>動物化特性</summary>
                <br>
                <span class="dol-link">
                    [[貓化特性|$passage][$cat = 6]]
                </span>
                <br>
                <span class="dol-link">
                    [[牛化特性|$passage][$cow = 6]]
                </span>
                <br>
                <span class="dol-link">
                    [[鳥化特性|$passage][$harpy = 6, $birdFly=1]]
                </span>
                <br>
                <span class="dol-link">
                    [[狼化特性|$passage][$wolfgirl = 6]]
                </span>
                <br>
                <span class="dol-link">
                    [[狐化特性|$passage][$fox = 6]]
                </span>
                <br>
                <span class="dol-link">
                    [[長獠牙|$passage][$transformationParts.traits.fangs to String.fromCharCode (105,115,110,111,32,116,100,101,102,97,117,108,116)]]
                </span>
                <br>
            </details>

            <!-- 蒐集 / 解鎖 -->
            <details>
                <summary>蒐集/解鎖</summary>
                <br>

                <!-- 學會所有食譜 -->
                <span class="dol-link">
                    <<link [[學會所有食譜|$passage]]>>
                        <<set _recipeCount to 0>>
                        <<for _recipeKey range Object.keys(setup.foodstuff)>>
                            <<if setup.foodstuff[_recipeKey].recipe?.ingredients?.length >= 1>>
                                <<if !$foodstuff[_recipeKey]>>
                                    <<set $foodstuff[_recipeKey] to {amount: 0}>>
                                <</if>>
                                <<set $foodstuff[_recipeKey].knows_recipe to true>>
                            <</if>>
                        <</for>>
                        <<for _recipeKey range Object.keys(setup.foodstuff)>>
                            <<if $foodstuff[_recipeKey]?.knows_recipe is true>>
                                <<set _recipeCount++>>
                            <</if>>
                        <</for>>
                        <<if _recipeCount >= 5>>
                            <<earnFeat "Chef de Tournant">>
                        <</if>>
                        <<if _recipeCount >= 20>>
                            <<earnFeat "Chef de Partie">>
                        <</if>>
                        <<if _recipeCount >= 50>>
                            <<earnFeat "Sous Chef">>
                        <</if>>
                    <</link>>
                </span>
                <br>

                <!-- 獲得所有種子 -->
                <span class="dol-link">
                    <<link [[獲得所有種子|$passage]]>>
                        <<run unlockAllSeeds()>>
                    <</link>>
                </span>
                <br>

                <!-- 獲得所有一般古董 -->
                <span class="dol-link">
                    <<link [[獲得所有一般古董|$passage]]>>
                        <<updateMuseumAntiques>>
                        <<set _antiqueValues to {
                            antiquebox: 10,
                            antiquesilverring: 20,
                            antiquegoldnecklace: 250,
                            antiquecrystal: 200,
                            antiquehorn: 100,
                            antiquewatch: 200,
                            antiquedildo: 50,
                            antiquecandlestick: 50,
                            antiqueforestarrow: 20,
                            antiqueforestdagger: 40,
                            antiqueforestgem: 100,
                            antiquesilverbrooch: 50,
                            antiquetrashcup: 50,
                            antiquetrashburner: 100,
                            antiquebrassstatuette: 120,
                            antiquecoppercompass: 50,
                            antiquegrenade: 80,
                            antiquestonetalisman: 1200,
                            antiquesilvermask: 3000,
                            antiquediamond: 2000,
