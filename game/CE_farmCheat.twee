:: CE_safeNumberSlider [widget]

<<widget "CE_safeNumberSlider">>
	<!-- =====================
	     參數讀取
	     ===================== -->

	<<set _CE_sliderPath to _args[0]>>
	<<set _CE_sliderRawValue to _args[1]>>
	<<set _CE_sliderMin to Number(_args[2])>>
	<<set _CE_sliderMax to Number(_args[3])>>
	<<set _CE_sliderStep to Number(_args[4])>>

	<!-- 保存原始正常範圍 -->
	<<set _CE_sliderNormalMin to _CE_sliderMin>>
	<<set _CE_sliderNormalMax to _CE_sliderMax>>

	<!-- =====================
	     嚴格檢查當前值

	     只接受：
	     1. 有限的 number
	     2. 非空白且可轉為有限數字的 string

	     拒絕：
	     undefined、null、空字串、布林值、
	     陣列、物件、NaN、Infinity 等
	     ===================== -->

	<<set _CE_sliderValueValid to
		(
			typeof _CE_sliderRawValue is "number"
			and Number.isFinite(_CE_sliderRawValue)
		)
		or
		(
			typeof _CE_sliderRawValue is "string"
			and _CE_sliderRawValue.trim() is not ""
			and Number.isFinite(Number(_CE_sliderRawValue))
		)
	>>

	<!-- 通過嚴格檢查後才進行數字轉換 -->
	<<if _CE_sliderValueValid>>
		<<set _CE_sliderNumber to Number(_CE_sliderRawValue)>>
	<<else>>
		<<set _CE_sliderNumber to NaN>>
	<</if>>

	<!-- =====================
	     檢查滑塊設定本身
	     ===================== -->

	<<set _CE_sliderConfigValid to
		Number.isFinite(_CE_sliderMin)
		and Number.isFinite(_CE_sliderMax)
		and Number.isFinite(_CE_sliderStep)
		and _CE_sliderMin <= _CE_sliderMax
		and _CE_sliderStep > 0
	>>

	<!-- =====================
	     當前值與滑塊設定都有效
	     ===================== -->

	<<if _CE_sliderConfigValid and _CE_sliderValueValid>>

		<!--
			目前值低於正常最小值：
			依照 step 向下擴張實際最小值。
		-->
		<<if _CE_sliderNumber < _CE_sliderNormalMin>>
			<<set _CE_sliderMin to
				_CE_sliderNormalMin
				- Math.ceil(
					(_CE_sliderNormalMin - _CE_sliderNumber)
					/ _CE_sliderStep
				) * _CE_sliderStep
			>>
		<</if>>

		<!--
			目前值高於正常最大值：
			依照 step 向上擴張實際最大值。
		-->
		<<if _CE_sliderNumber > _CE_sliderNormalMax>>
			<<set _CE_sliderMax to
				_CE_sliderNormalMax
				+ Math.ceil(
					(_CE_sliderNumber - _CE_sliderNormalMax)
					/ _CE_sliderStep
				) * _CE_sliderStep
			>>
		<</if>>

		<!-- 顯示滑塊 -->
		<<numberslider
			_CE_sliderPath
			_CE_sliderNumber
			_CE_sliderMin
			_CE_sliderMax
			_CE_sliderStep
		>>

		<!-- 超出正常範圍時顯示提示 -->
		<<if _CE_sliderNumber < _CE_sliderNormalMin
			or _CE_sliderNumber > _CE_sliderNormalMax>>

			<div class="dol-desc" style="margin: 4px 0 8px 0;">
				<span class="dol-red">
					數值超出正常範圍，滑塊範圍已自動擴展
				</span>
				<br>

				當前值：
				<span class="gold">
					<<print _CE_sliderRawValue>>
				</span>
				<br>

				正常範圍：
				<span style="color: gray;">
					<<print _CE_sliderNormalMin>>
					-
					<<print _CE_sliderNormalMax>>
				</span>
				<br>

				當前滑塊範圍：
				<span style="color: gray;">
					<<print _CE_sliderMin>>
					-
					<<print _CE_sliderMax>>
				</span>
			</div>

		<</if>>

	<!-- =====================
	     異常資料：不顯示滑塊
	     ===================== -->

	<<else>>

		<div class="dol-desc" style="margin: 4px 0 8px 0;">
			<span class="dol-red">
				當前值或滑塊參數無效，已隱藏滑塊
			</span>
			<br>

			當前值：
			<span class="gold">
				<<if _CE_sliderRawValue is undefined>>
					undefined
				<<elseif _CE_sliderRawValue is null>>
					null
				<<elseif typeof _CE_sliderRawValue is "string"
					and _CE_sliderRawValue.trim() is "">>
					空字符串
				<<else>>
					<<print _CE_sliderRawValue>>
				<</if>>
			</span>
			<br>

			正常範圍：
			<span style="color: gray;">
				<<print _CE_sliderNormalMin>>
				-
				<<print _CE_sliderNormalMax>>
			</span>

			<<if !_CE_sliderConfigValid>>
				<br>
				<span style="color: gray;">
					滑塊配置：
					min = <<print _CE_sliderMin>>，
					max = <<print _CE_sliderMax>>，
					step = <<print _CE_sliderStep>>
				</span>
			<</if>>
		</div>

	<</if>>
<</widget>>

:: CE_farmCheatPanel [widget]

<<widget "CE_farmCheatPanel">>
<div class="dol-settings dol-shadow">

	<div class="dol-header">
		<span class="dol-title">農場作弊助手 (Farm Cheat Helper)</span>
	</div>

	<div class="dol-body">

		<div class="dol-desc">
			快速完成農場升級，瞬間解鎖全建築，拉滿牲畜或自動收穫。
		</div>

		<br>


		<!-- ================================================== -->
		<!-- 初始化农场变量 -->
		<!-- ================================================== -->

		<<if $farm is undefined>>
			<<set $farm to {
				wall: 0,
				tower: 0,
				woodland: 0,
				kennel: 0,
				barn: 0,
				stable: 0,
				coop: 0,
				parasitebarn: 0,
				irrigation: 0,
				build: 0,
				build_timer: 0,
				clearing: 100,
				aggro: 0,
				beasts: {
					pigs: 0,
					horses: 0,
					cattle: 0,
					dogs: 0
				},
				milking: {
					caught: false,
					alexNightEvent: false,
					catchChance: 0,
					dayMilking: false
				},
				build_finished: []
			}>>
		<</if>>

		<<if $farm.wall is undefined>>
			<<set $farm.wall to 0>>
		<</if>>

		<<if $farm.tower is undefined>>
			<<set $farm.tower to 0>>
		<</if>>

		<<if $farm.woodland is undefined>>
			<<set $farm.woodland to 0>>
		<</if>>

		<<if $farm.kennel is undefined>>
			<<set $farm.kennel to 0>>
		<</if>>

		<<if $farm.barn is undefined>>
			<<set $farm.barn to 0>>
		<</if>>

		<<if $farm.stable is undefined>>
			<<set $farm.stable to 0>>
		<</if>>

		<<if $farm.coop is undefined>>
			<<set $farm.coop to 0>>
		<</if>>

		<<if $farm.parasitebarn is undefined>>
			<<set $farm.parasitebarn to 0>>
		<</if>>

		<<if $farm.irrigation is undefined>>
			<<set $farm.irrigation to 0>>
		<</if>>

		<<if $farm.aggro is undefined>>
			<<set $farm.aggro to 0>>
		<</if>>

		<<if $farm.build is undefined>>
			<<set $farm.build to 0>>
		<</if>>

		<<if $farm.build_timer is undefined>>
			<<set $farm.build_timer to 0>>
		<</if>>


		<!-- ================================================== -->
		<!-- 初始化牲畜变量 -->
		<!-- ================================================== -->

		<<if $farm.beasts is undefined>>
			<<set $farm.beasts to {
				pigs: 0,
				horses: 0,
				cattle: 0,
				dogs: 0
			}>>
		<</if>>

		<<if $farm.beasts.pigs is undefined>>
			<<set $farm.beasts.pigs to 0>>
		<</if>>

		<<if $farm.beasts.horses is undefined>>
			<<set $farm.beasts.horses to 0>>
		<</if>>

		<<if $farm.beasts.cattle is undefined>>
			<<set $farm.beasts.cattle to 0>>
		<</if>>

		<<if $farm.beasts.dogs is undefined>>
			<<set $farm.beasts.dogs to 0>>
		<</if>>


		<!-- ================================================== -->
		<!-- 初始化其他变量 -->
		<!-- ================================================== -->

		<<if $farm_work is undefined>>
			<<set $farm_work to {
				fence_damage: 0
			}>>
		<</if>>

		<<if $farm_work.fence_damage is undefined>>
			<<set $farm_work.fence_damage to 0>>
		<</if>>		

		<<if $alex_greenhouse is undefined>>
			<<set $alex_greenhouse to 0>>
		<</if>>


		<!-- ================================================== -->
		<!-- 一鍵快捷操作 -->
		<!-- ================================================== -->

		<div class="dol-header">
			<span class="dol-title">一鍵快捷操作 (Quick Actions)</span>
		</div>

		<br>

		<div class="dol-btn">

			<<button "一鍵完美升級農場">>

				<<set $farm_stage to 12>>

				<<set $farm.wall to 4>>
				<<set $farm.tower to 2>>
				<<set $farm.woodland to 3>>
				<<set $farm.kennel to 1>>
				<<set $farm.barn to 2>>
				<<set $farm.stable to 1>>
				<<set $farm.coop to 2>>
				<<set $farm.parasitebarn to 2>>
				<<set $farm.irrigation to 9>>

				<<set $farm.build to 0>>
				<<set $farm.build_timer to 0>>

				<<set $farm.clearing to 0>>
				<<set $farm.aggro to 0>>

				<<set $farm.beasts.pigs to 30>>
				<<set $farm.beasts.horses to 30>>
				<<set $farm.beasts.cattle to 30>>
				<<set $farm.beasts.dogs to 30>>

				<<set $alex_greenhouse to 3>>
				<<set $alex_greenhouse_timer to 0>>

				<<set $cottage_nursery_prep to undefined>>
				<<set C.npc.Alex.pregnancy.nursery to true>>

				<<if $wardrobes.alexFarm is undefined>>
					<<set $wardrobes.alexFarm to {}>>
				<</if>>

				<<set $wardrobes.alexFarm.unlocked to true>>


				<!-- 重新配置并开垦全部 9 块大型优质农田 -->

				<<set $plots.farm to []>>

				<<for _i to 0; _i lt 9; _i++>>

					<<set $plots.farm[_i] to {
						plant: "none",
						stage: 0,
						days: 0,
						water: 1,
						till: 1,
						bed: "earth",
						quality: 4,
						size: "large"
					}>>

				<</for>>

				<<replace #CE_settingsDiv>>
					<<CE_farmCheatPanel>>
				<</replace>>

			<</button>>

		</div>

		<div class="dol-desc" style="font-size: 0.85em; color: gray; margin-top: 4px;">
			※ 將故事線拉到第 12 階段，所有建築升至滿級，解鎖農場育兒室與更衣室，擁有 9 塊已鬆土的特級大型自動灌溉農田，並將所有牲畜補滿到 30 隻上限。
		</div>

		<br>


		<!-- ================================================== -->
		<!-- 完成当前建造 -->
		<!-- ================================================== -->

		<div class="dol-btn">

			<<button "立刻完成當前建造項目">>

				<<if $farm.build isnot 0 and $farm.build isnot undefined>>

					<<switch $farm.build>>

						<<case "wall 1">>
							<<set $farm.wall to 1>>

						<<case "wall 2">>
							<<set $farm.wall to 2>>

						<<case "wall 3">>
							<<set $farm.wall to 3>>

						<<case "wall 4">>
							<<set $farm.wall to 4>>

						<<case "tower 1">>
							<<set $farm.tower to 1>>

						<<case "tower 2">>
							<<set $farm.tower to 2>>

						<<case "woodland 1">>
							<<set $farm.woodland to 1>>

						<<case "woodland 2">>
							<<set $farm.woodland to 2>>

						<<case "woodland 3">>
							<<set $farm.woodland to 3>>

						<<case "kennel 1">>
							<<set $farm.kennel to 1>>

						<<case "barn 1">>
							<<set $farm.barn to 1>>

						<<case "barn 2">>
							<<set $farm.barn to 2>>

						<<case "stable 1">>
							<<set $farm.stable to 1>>

						<<case "coop 1">>
							<<set $farm.coop to 1>>

						<<case "coop 2">>
							<<set $farm.coop to 2>>

						<<case "parasites 1">>
							<<set $farm.parasitebarn to 1>>

						<<case "parasites 2">>

							<<set $farm.parasitebarn to 2>>

							<<if $container and $container.farm>>

								<<set $container.farm.upgrades.capacity to 1>>
								<<set $container.farm.maxCount to 7>>

								<<set $container.farm.upgrades.foodStorage to 1>>
								<<set $container.farm.maxDaysWithoutFood to 31>>

								<<set $container.farm.upgrades.luxury to 3>>

							<</if>>

						<<case "irrigation">>

							<<if $farm.irrigation is undefined>>

								<<set $farm.irrigation to 1>>

							<<elseif $farm.irrigation lt 9>>

								<<set $farm.irrigation++>>

							<</if>>

						<<case "nursery">>

							<<set C.npc.Alex.pregnancy.nursery to true>>
							<<unset $cottage_nursery_prep>>

					<</switch>>


					<<if $farm.build_finished is undefined or $farm.build_finished is 0>>

						<<set $farm.build_finished to []>>

					<</if>>

					<<run $farm.build_finished.pushUnique($farm.build)>>

					<<set $farm.build to 0>>
					<<set $farm.build_timer to 0>>

				<</if>>


				<<replace #CE_settingsDiv>>
					<<CE_farmCheatPanel>>
				<</replace>>

			<</button>>

		</div>

		<div class="dol-desc" style="font-size: 0.85em; color: gray; margin-top: 4px;">

			<<if $farm.build isnot 0 and $farm.build isnot undefined>>

				當前正在建造:
				<span class="gold">
					<<print $farm.build>>
				</span>

				(剩餘天數: <<print $farm.build_timer>> 天)

			<<else>>

				當前沒有正在進行的建造項目。

			<</if>>

		</div>

		<br>


		<!-- ================================================== -->
		<!-- 作物瞬间成熟 -->
		<!-- ================================================== -->

		<div class="dol-btn">

			<<button "農作物瞬間成熟">>

				<<run tendingInstaGrow("farm")>>

				<<replace #CE_settingsDiv>>
					<<CE_farmCheatPanel>>
				<</replace>>

			<</button>>

		</div>

		<div class="dol-desc" style="font-size: 0.85em; color: gray; margin-top: 4px;">
			※ 立刻讓農場所有已播種的農田內的作物成熟。
		</div>

		<br>
		<br>


		<!-- ================================================== -->
		<!-- 細項升級控制 -->
		<!-- ================================================== -->

		<div class="dol-header">
			<span class="dol-title">細項升級控制 (Detailed Upgrades)</span>
		</div>

		<br>

		<div class="dol-section">

			<div class="dol-desc">
				農場主線階段 (0 - 12):
			</div>

			<<CE_safeNumberSlider "$farm_stage" $farm_stage 0 12 1>>

			<br>


			<div class="dol-desc">
				石牆/圍欄等級 (0 - 4):
			</div>

			<<CE_safeNumberSlider "$farm.wall" $farm.wall 0 4 1>>

			<br>


			<div class="dol-desc">
				瞭望塔等級 (0 - 2):
			</div>

			<<CE_safeNumberSlider "$farm.tower" $farm.tower 0 2 1>>

			<br>


			<div class="dol-desc">
				林地吞併等級 (0 - 3):
			</div>

			<<CE_safeNumberSlider "$farm.woodland" $farm.woodland 0 3 1>>

			<br>


			<div class="dol-desc">
				獵犬舍防衛訓練 (0 - 1):
			</div>

			<<CE_safeNumberSlider "$farm.kennel" $farm.kennel 0 1 1>>

			<br>


			<div class="dol-desc">
				穀倉與自動擠奶等級 (0 - 2):
			</div>

			<<CE_safeNumberSlider "$farm.barn" $farm.barn 0 2 1>>

			<br>


			<div class="dol-desc">
				馬廄擴建等級 (0 - 1):
			</div>

			<<CE_safeNumberSlider "$farm.stable" $farm.stable 0 1 1>>

			<br>


			<div class="dol-desc">
				雞舍擴建等級 (0 - 2):
			</div>

			<<CE_safeNumberSlider "$farm.coop" $farm.coop 0 2 1>>

			<br>


			<div class="dol-desc">
				寄生蟲穀倉等級 (0 - 2):
			</div>

			<<CE_safeNumberSlider "$farm.parasitebarn" $farm.parasitebarn 0 2 1>>

			<br>


			<div class="dol-desc">
				已安裝灌溉的土地數 (0 - 9):
			</div>

			<<CE_safeNumberSlider "$farm.irrigation" $farm.irrigation 0 9 1>>

			<br>


			<div class="dol-desc">
				Remy 敵對騷擾值 (0 - 100):
			</div>

			<<CE_safeNumberSlider "$farm.aggro" $farm.aggro 0 100 5>>

			<br>


			<div class="dol-desc">
				圍欄受損程度 (0 - 100):
			</div>

			<<CE_safeNumberSlider "$farm_work.fence_damage" $farm_work.fence_damage 0 100 5>>

			<br>


			<div class="dol-desc">
				孤兒院 Alex 溫室等級 (0 - 3):
			</div>

			<<CE_safeNumberSlider "$alex_greenhouse" $alex_greenhouse 0 3 1>>

			<br>

		</div>

		<br>


		<!-- ================================================== -->
		<!-- 牲畜與育兒室設置 -->
		<!-- ================================================== -->

		<div class="dol-header">
			<span class="dol-title">牲畜與育兒室設置 (Livestock & Nursery)</span>
		</div>

		<br>

		<div class="dol-section">

			<div class="dol-desc">
				豬隻數量 (0 - 30):
			</div>

			<<CE_safeNumberSlider "$farm.beasts.pigs" $farm.beasts.pigs 0 30 1>>

			<br>


			<div class="dol-desc">
				馬匹數量 (0 - 30):
			</div>

			<<CE_safeNumberSlider "$farm.beasts.horses" $farm.beasts.horses 0 30 1>>

			<br>


			<div class="dol-desc">
				牛隻數量 (0 - 30):
			</div>

			<<CE_safeNumberSlider "$farm.beasts.cattle" $farm.beasts.cattle 0 30 1>>

			<br>


			<div class="dol-desc">
				牧羊犬數量 (0 - 30):
			</div>

			<<CE_safeNumberSlider "$farm.beasts.dogs" $farm.beasts.dogs 0 30 1>>

			<br>


			<div class="dol-desc">
				農場小屋育兒室解鎖狀態:
			</div>

			<div class="dol-btn">

				<<button "切換育兒室解鎖狀態">>

					<<if C.npc.Alex.pregnancy.nursery is true>>

						<<set C.npc.Alex.pregnancy.nursery to false>>

					<<else>>

						<<set C.npc.Alex.pregnancy.nursery to true>>

					<</if>>

					<<replace #CE_settingsDiv>>
						<<CE_farmCheatPanel>>
					<</replace>>

				<</button>>

			</div>


			<div class="dol-desc" style="font-size: 0.85em; color: gray; margin-top: 4px;">

				當前狀態:

				<<if C.npc.Alex.pregnancy.nursery is true>>

					<span class="dol-green">
						已解鎖 (Unlocked)
					</span>

				<<else>>

					<span class="dol-red">
						未解鎖 (Locked)
					</span>

				<</if>>

			</div>

		</div>

		<br>
		<br>


		<!-- ================================================== -->
		<!-- 保存并刷新 -->
		<!-- ================================================== -->

		<div class="dol-btn">

			<<button "保存並刷新面板">>

				<<replace #CE_settingsDiv>>
					<<CE_farmCheatPanel>>
				<</replace>>

			<</button>>

		</div>

	</div>
</div>
<</widget>>